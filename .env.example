# PoultryPilot — environment variables
#
# Copy to .env.local and fill in from your Supabase project dashboard.
# .env.local is gitignored. NEVER commit real values.
#
# ⚠️ SECRET DISCIPLINE (docs/GAPS.md G-72)
#    Only NEXT_PUBLIC_* variables reach the browser. Everything else is server-only.
#    The service-role key BYPASSES ROW LEVEL SECURITY — leaking it into a client
#    bundle would completely undo the G-65 lockdown, and invisibly.
#    CI enforces this via `test:secrets`.

# ── Public — safe in the browser bundle ────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# ── Server-only — MUST NOT be prefixed NEXT_PUBLIC_ ────────────────────────

# Bypasses RLS. Used only for admin operations such as inviting users.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# NOTE: there is deliberately no SUPABASE_JWT_SECRET (removed 2026-07-21).
# Supabase signs access tokens with asymmetric keys (ES256). The route handler
# verifies them against the JWKS endpoint, derived from the URL above:
#   ${NEXT_PUBLIC_SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Nothing secret is involved, so there is nothing here to configure or to leak.
# See API.md §2. If your project still shows "Legacy JWT secret (still used)",
# migrate it to asymmetric signing keys rather than adding the secret back.

# Runtime connection — POOLER, port 6543, transaction mode.
# The query parameters are required, not optional:
#   pgbouncer=true      disables prepared statements (unsupported in transaction mode)
#   connection_limit=1  one connection per serverless instance
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations — DIRECT connection, port 5432. Used by prisma.config.ts only.
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Local development mirrors this split (docs/GAPS.md G-80): the CLI's Supavisor
# runs on 54329 as tenant `postgres.pooler-dev`, with Postgres direct on 54322.
# It is enabled by `[db.pooler] enabled = true` in supabase/config.toml.
# `npm run verify:pooler` asserts the two URLs are genuinely different endpoints.

# ── Email ──────────────────────────────────────────────────────────────────
# Farm alerts only. User invitations are sent by Supabase Auth (BR-09).
#
# ⚠️ Supabase's DEFAULT mail service sends 2 messages/hour and refuses any address
#    outside the project team — invitations fail SILENTLY (docs/GAPS.md G-66).
#    Configure this key as custom SMTP under Auth → Email Settings before launch.
SENDGRID_API_KEY="<sendgrid-api-key>"
